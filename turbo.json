{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_CHAIN_ID",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_LANDING_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_DOCS_URL",
        "NEXT_PUBLIC_RPC_URL",
        "NEXT_PUBLIC_CONTRACTS_DEPLOYED"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:e2e:stack": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "contracts:compile": {
      "inputs": ["contracts/**", "hardhat.config.*"],
      "outputs": ["artifacts/**", "cache/**", "types/**"]
    },
    "contracts:test": {
      "dependsOn": ["contracts:compile"]
    }
  }
}
