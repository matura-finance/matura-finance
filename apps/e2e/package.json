{
  "name": "@matura/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test --config playwright.remote.config.ts",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-landing-bundle.mjs && node scripts/check-app-secrets.mjs",
    "assert:public-config": "node scripts/assert-public-config.mjs",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "devDependencies": {
    "@matura/typescript-config": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "catalog:",
    "viem": "catalog:"
  }
}
