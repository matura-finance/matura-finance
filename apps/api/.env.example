# Matura API — copy to .env and fill in. Secrets never committed. Contract
# addresses are NEVER here; they come from @matura/chain per-chain manifests.

# Core
NODE_ENV="development"
PORT="3000"
DATABASE_URL="postgresql://matura:matura@localhost:5432/matura?schema=public"
API_CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Chain / RPC
CHAIN_ID="31337"
RPC_URL="http://127.0.0.1:8545"

# Indexer (0 confirmations → index up to the `finalized` block tag)
INDEXER_CONFIRMATIONS="0"
INDEXER_MAX_BLOCK_RANGE="1000"
INDEXER_POLL_INTERVAL_MS="4000"

# Health readiness thresholds
CURSOR_STALE_MS="30000"
CURSOR_MAX_LAG_BLOCKS="200"

# Issuer demo signer (attestation signer — most sensitive). Leave empty unless
# running the local demo-signing path. NEVER set in production.
ISSUER_PRIVATE_KEY=""
