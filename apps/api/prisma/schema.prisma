// Matura API — event-log PROJECTIONS of on-chain state.
//
// Every projected row carries `blockNumber` + `logIndex` and a natural chain key
// so an idempotent, reorg-safe indexer can upsert on replay instead of
// duplicating. Monetary fields are String base-units (exact on-chain match, no
// float risk); addresses are stored lowercase (checksum-validated at the edge).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClaimType {
  PAYROLL
  FREELANCE_ESCROW
  STREAM
}

enum ClaimState {
  ATTESTED
  ELIGIBLE
  PARTIALLY_FUNDED
  FUNDED
  MATURED
  PAID
  DELAYED
  DISPUTED
  DEFAULTED
  REJECTED
  REVOKED
}

enum RouteStatus {
  PENDING
  EXECUTED
  FAILED
}

model UserWallet {
  id        String   @id @default(cuid())
  address   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClaimProjection {
  claimId           String     @id
  beneficiary       String
  issuer            String
  claimType         ClaimType
  token             String
  faceValue         String // base-units string
  financedFaceValue String // base-units string
  dueAt             DateTime
  state             ClaimState
  txHash            String
  blockNumber       BigInt
  logIndex          Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  legs       RouteLegProjection[]
  settlement SettlementProjection?

  // NOTE: no @@unique([txHash, logIndex]) — claims are idempotent via the claimId PK (upsert
  // keys on claimId), and txHash/logIndex are OVERWRITTEN to the latest mutating event, so a
  // constraint on them would be both misleading and unnecessary.
  @@index([beneficiary])
  @@index([issuer])
  @@index([state, dueAt])
  @@index([beneficiary, state])
  @@index([issuer, state])
  @@index([beneficiary, blockNumber, logIndex])
}

model RouteExecution {
  executionId       String      @id
  user              String
  // Nullable: recovered by decoding the executeRoute calldata; null when the tx wasn't a
  // direct executeRoute call (e.g. via an aggregator) so it's never a misleading real "0".
  targetAdvance     String?
  totalAdvance      String
  totalFaceAssigned String
  totalCost         String
  status            RouteStatus
  txHash            String
  blockNumber       BigInt
  logIndex          Int
  createdAt         DateTime    @default(now())

  legs RouteLegProjection[]

  @@unique([txHash, logIndex])
  @@index([user])
  @@index([user, blockNumber, logIndex])
}

model RouteLegProjection {
  id             String @id @default(cuid())
  executionId    String
  claimId        String
  vault          String
  faceAmount     String
  advanceAmount  String
  discountAmount String
  blockNumber    BigInt
  logIndex       Int

  execution RouteExecution  @relation(fields: [executionId], references: [executionId], onDelete: Cascade)
  claim     ClaimProjection @relation(fields: [claimId], references: [claimId], onDelete: Cascade)

  @@unique([executionId, claimId])
  @@index([executionId])
  @@index([claimId])
}

model ChainCursor {
  consumerName           String
  chainId                Int
  lastProcessedBlock     BigInt
  lastProcessedBlockHash String
  updatedAt              DateTime @updatedAt

  @@id([consumerName, chainId])
}

// Settlement receipt. The four amounts exist ONLY in the `ClaimSettled` event
// (SettlementManager has no receipt getter), so they must be projected here.
// `beneficiary` is denormalized from the claim so portfolio/activity reads don't cross-join.
model SettlementProjection {
  claimId           String   @id
  beneficiary       String
  amountReceived    String
  vaultDistribution String
  userResidual      String
  protocolFee       String
  txHash            String
  blockNumber       BigInt
  logIndex          Int
  createdAt         DateTime @default(now())

  claim ClaimProjection @relation(fields: [claimId], references: [claimId], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([beneficiary])
}

// Append-only activity feed. One immutable row per relevant log (never mutated),
// so keyset pagination on (blockNumber, logIndex) is stable — unlike the mutable
// aggregate projections. `wallet` is the beneficiary/user the event belongs to.
model ActivityEvent {
  id          String   @id @default(cuid())
  wallet      String
  kind        String
  claimId     String?
  executionId String?
  payload     Json
  txHash      String
  blockNumber BigInt
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex, wallet])
  @@index([wallet, blockNumber, logIndex])
}

// Single-use SIWE nonce. Consumed atomically:
// UPDATE ... WHERE nonce=$1 AND used=false AND expiresAt>now() RETURNING.
model AuthNonce {
  nonce     String   @id
  domain    String
  chainId   Int
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Lifecycle of a short-lived route intent. Distinct from RouteStatus (the
// indexer's on-chain execution projection). Single source of truth for "is this
// intent still usable" — no separate `consumed` boolean.
enum RouteIntentStatus {
  PENDING
  CONSUMED
  FAILED
}

// A short-lived best-execution route intent produced by POST /routes/optimize
// and consumed once by POST /routes/:routeId/prepare-execution. Standalone (NO
// FK to the projection tables — the indexer full-wipes those on reorg, which
// would cascade-delete or block live intents). `routeId` is a keccak256 content
// hash of (user, quoteSnapshotHash, canonical legs, target, caps, deadline), so
// re-optimizing identical inputs collides on the PK: create-or-ignore, never
// upsert (an upsert would revive a CONSUMED intent — single-use bypass).
// Consumed atomically:
// UPDATE ... SET status='CONSUMED' WHERE routeId=$1 AND user=$2 AND status='PENDING' AND expiresAt>now() RETURNING.
// The persisted advance/cost figures are estimate-at-blockNumber (the on-chain
// recompute at execution is authoritative). Money is base-unit strings.
model RouteIntent {
  routeId              String            @id
  user                 String
  status               RouteIntentStatus @default(PENDING)
  targetAdvance        String
  maxTotalFace         String?
  maxTotalCost         String?
  totalAdvance         String
  totalFaceAssigned    String
  totalCost            String
  effectiveDiscountBps Int
  legs                 Json
  rejected             Json
  explanation          Json
  quoteSnapshotHash    String
  blockNumber          BigInt
  routeDeadlineSeconds Int
  expiresAt            DateTime
  createdAt            DateTime          @default(now())

  @@index([expiresAt])
}
