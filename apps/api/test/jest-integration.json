{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.int-spec\\.ts$",
  "testTimeout": 120000,
  "maxWorkers": 1,
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/jest-setup.ts"]
}
