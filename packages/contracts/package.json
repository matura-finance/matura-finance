{
  "name": "@matura/contracts",
  "type": "module",
  "private": true,
  "scripts": {
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:export-abis": "hardhat compile && node scripts/export-abis.ts",
    "contracts:export-demo-fixture": "node scripts/export-demo-fixture.ts",
    "typecheck": "hardhat compile && tsc --noEmit",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "preflight:bsc-testnet": "hardhat run scripts/preflight.ts --network bscTestnetSeed",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "seed:bsc-testnet": "hardhat run scripts/seed.ts --network bscTestnetSeed",
    "verify:local": "hardhat run scripts/verify.ts --network localhost",
    "verify:bsc-testnet": "hardhat run scripts/verify.ts --network bscTestnet",
    "verify:bsc-testnet:explorer": "hardhat run scripts/verify-explorer.ts --network bscTestnet",
    "check-deployment:bsc-testnet": "hardhat run scripts/check-deployment.ts --network bscTestnet",
    "smoke:local": "hardhat run scripts/smoke.ts --network localhost",
    "smoke:bsc-testnet": "hardhat run scripts/smoke.ts --network bscTestnet",
    "demo:local": "pnpm run deploy:local && pnpm run seed:local && pnpm run verify:local",
    "demo:reset:full": "pnpm run demo:reset && pnpm run demo:local",
    "demo:settle": "hardhat run scripts/demo-settle.ts --network localhost",
    "demo:testnet-execute": "hardhat run scripts/demo-testnet-execute.ts --network bscTestnet",
    "demo:reset": "node scripts/demo-reset.ts"
  },
  "devDependencies": {
    "hardhat": "3.18.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.3",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0",
    "@nomicfoundation/hardhat-keystore": "3.1.0",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "viem": "catalog:",
    "fast-check": "catalog:",
    "typescript": "~5.8.3",
    "@types/node": "^22.10.0"
  }
}
