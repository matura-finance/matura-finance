# =============================================================================
# Matura — environment template. Copy to `.env` (git-ignored) and fill in.
# =============================================================================

# ── SERVER-ONLY — NEVER exposed to the browser, never committed ───────────────
# These live only in apps/api/.env and packages/contracts (or the Hardhat keystore).
# Do NOT load this section into the Next.js apps.

# Postgres connection string (apps/api)
DATABASE_URL="postgresql://matura:matura@localhost:5432/matura?schema=public"

# BSC Testnet JSON-RPC (server/deploy only). If a keyed RPC is used, keep it here —
# never expose a keyed RPC as NEXT_PUBLIC_*.
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.bnbchain.org:8545"

# Deploy account key — prefer `hardhat keystore set DEPLOYER_PRIVATE_KEY` over plaintext.
DEPLOYER_PRIVATE_KEY=""

# EIP-712 attestation signer key — MOST sensitive secret. Keystore / CI secret store only.
ISSUER_PRIVATE_KEY=""

# Server-side base URL for the API process
API_URL="http://localhost:3000"

# CORS allowlist for the API (comma-separated). Localhost is added automatically in dev.
API_CORS_ORIGINS="https://app.matura.xyz,https://matura.xyz"

# ── PUBLIC — safe for browser bundles (NEXT_PUBLIC_* only) ────────────────────
NEXT_PUBLIC_CHAIN_ID="97"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_LANDING_URL="https://matura.xyz"
NEXT_PUBLIC_APP_URL="https://app.matura.xyz"

# Deployed contract addresses (empty is valid for the foundation; filled after deploy).
NEXT_PUBLIC_MOCK_USDT_ADDRESS=""
NEXT_PUBLIC_ISSUER_REGISTRY_ADDRESS=""
NEXT_PUBLIC_CLAIM_REGISTRY_ADDRESS=""
NEXT_PUBLIC_VAULT_REGISTRY_ADDRESS=""
NEXT_PUBLIC_ROUTER_ADDRESS=""
NEXT_PUBLIC_SETTLEMENT_MANAGER_ADDRESS=""
